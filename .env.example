# ─── Vercel (Environment Variables) ───
# Settings → Environment Variables → Production + Preview

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role — só no servidor, nunca no frontend

# Chave compartilhada pelo time (invente uma string longa)
REPORTS_API_KEY=sua-chave-secreta-aqui

# Mesma chave no build do frontend (Vite expõe só variáveis VITE_*)
VITE_REPORTS_API_KEY=sua-chave-secreta-aqui

# Salt do hash de e-mail nas facts de suporte (sha256). Só no servidor.
# Sem este valor o ETL grava contact_email_hash nulo — nunca o e-mail em claro.
REPORTS_PII_SALT=outro-segredo-longo

# Google Analytics 4 (OS2). Sem as três, /api/bi/sync/ga responde not_configured.
# GA_PRIVATE_KEY: cole com \n escapados, como a JSON key da service account.
# Property ID numérico (Admin → Property settings), não o Measurement ID G-.
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=

# Bearer que a Vercel envia no cron horário de /api/bi/sync/ga.
CRON_SECRET=

# Metabase / ops. Sem URL + API key, /api/bi/sync/metabase responde not_configured.
METABASE_URL=
METABASE_API_KEY=
METABASE_DATABASE_ID=
